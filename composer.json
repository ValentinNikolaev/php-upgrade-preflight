{
  "name": "php-upgrade-preflight/monorepo",
  "description": "Development monorepo for PHP Upgrade Preflight.",
  "type": "project",
  "license": "PolyForm-Noncommercial-1.0.0",
  "authors": [
    {
      "name": "Valentin Nikolaev"
    }
  ],
  "homepage": "https://github.com/ValentinNikolaev/php-upgrade-preflight",
  "support": {
    "issues": "https://github.com/ValentinNikolaev/php-upgrade-preflight/issues",
    "source": "https://github.com/ValentinNikolaev/php-upgrade-preflight"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/core",
      "options": {
        "symlink": true,
        "versions": {
          "php-upgrade-preflight/core": "0.3.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "packages/cli",
      "options": {
        "symlink": true,
        "versions": {
          "php-upgrade-preflight/cli": "0.3.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "packages/laravel",
      "options": {
        "symlink": true,
        "versions": {
          "php-upgrade-preflight/laravel": "0.3.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "packages/test-adapter",
      "options": {
        "symlink": true,
        "versions": {
          "php-upgrade-preflight/test-adapter": "0.3.x-dev"
        }
      }
    },
    {
      "type": "path",
      "url": "packages/legacy-test-adapter",
      "options": {
        "symlink": true,
        "versions": {
          "php-upgrade-preflight/legacy-test-adapter": "0.3.x-dev"
        }
      }
    }
  ],
  "require": {
    "php": "^8.0",
    "php-upgrade-preflight/core": "0.3.x-dev",
    "php-upgrade-preflight/cli": "0.3.x-dev",
    "php-upgrade-preflight/laravel": "0.3.x-dev"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.64",
    "illuminate/container": "^8.0",
    "opis/json-schema": "^2.6",
    "php-upgrade-preflight/legacy-test-adapter": "0.3.x-dev",
    "php-upgrade-preflight/test-adapter": "0.3.x-dev",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^9.6",
    "symfony/yaml": "^5.4 || ^6.0 || ^7.0"
  },
  "autoload-dev": {
    "psr-4": {
      "PhpUpgradePreflight\\Cli\\Tests\\": "packages/cli/tests/",
      "PhpUpgradePreflight\\Core\\Tests\\": "packages/core/tests/",
      "PhpUpgradePreflight\\Laravel\\Tests\\": "packages/laravel/tests/",
      "PhpUpgradePreflight\\LegacyTestAdapter\\": "packages/legacy-test-adapter/src/",
      "PhpUpgradePreflight\\Tests\\Support\\": "tests/Support/"
    }
  },
  "scripts": {
    "validate:all": [
      "@composer validate --strict",
      "@composer validate --strict packages/core/composer.json",
      "@composer validate --strict packages/cli/composer.json",
      "@composer validate --strict packages/laravel/composer.json",
      "@composer validate --strict packages/test-adapter/composer.json",
      "@composer validate --strict packages/legacy-test-adapter/composer.json"
    ],
    "test": "@test:all",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:smoke": "phpunit --testsuite smoke",
    "test:unit-smoke": [
      "@test:unit",
      "@test:smoke"
    ],
    "test:integration:windows-parity-a": "phpunit --testsuite integration --group windows-parity-a --log-junit build/junit-windows-parity-a.xml",
    "test:integration:windows-parity-b": "phpunit --testsuite integration --group windows-parity-b --log-junit build/junit-windows-parity-b.xml",
    "test:integration:windows-heavy": "phpunit --testsuite integration --group windows-integration-heavy --log-junit build/junit-windows-integration-heavy.xml",
    "test:integration:windows-rest": "phpunit --testsuite integration --exclude-group windows-parity-a,windows-parity-b,windows-integration-heavy --log-junit build/junit-windows-integration-rest.xml",
    "test:integration:staged-budget": "phpunit --filter WorstCaseStagedBudgetTest",
    "test:all": [
      "@test:unit",
      "@test:integration",
      "@test:smoke"
    ],
    "test:coverage": [
      "php -r \"if (is_file('build/coverage/clover.xml') && !unlink('build/coverage/clover.xml')) { exit(1); }\"",
      "phpunit --testsuite unit --coverage-clover build/coverage/clover.xml",
      "php tools/verify-coverage.php build/coverage/clover.xml"
    ],
    "test:mutation": "php tools/run-selective-mutations.php",
    "test:core": "phpunit --testsuite core",
    "test:cli": "phpunit --testsuite cli",
    "test:laravel": "phpunit --testsuite laravel",
    "test:fixtures": "phpunit --filter LaravelFixtureAnalysisTest",
    "release:verify": "php tools/verify-release.php",
    "analyse": [
      "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=512M",
      "phpstan analyse --configuration=phpstan-production.neon.dist --memory-limit=512M"
    ],
    "lint": "php-cs-fixer fix --dry-run --diff",
    "check": [
      "@validate:all",
      "@test",
      "@analyse",
      "@lint"
    ]
  },
  "config": {
    "platform": {
      "php": "8.0.30"
    },
    "sort-packages": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
