{
  "name": "php-upgrade-preflight/monorepo",
  "description": "Development monorepo for PHP Upgrade Preflight.",
  "type": "project",
  "license": "MIT",
  "private": true,
  "repositories": [
    {
      "type": "path",
      "url": "packages/core",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "packages/cli",
      "options": {
        "symlink": true
      }
    },
    {
      "type": "path",
      "url": "packages/laravel",
      "options": {
        "symlink": true
      }
    }
  ],
  "require": {
    "php": "^8.0",
    "php-upgrade-preflight/core": "*",
    "php-upgrade-preflight/cli": "*",
    "php-upgrade-preflight/laravel": "*"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
