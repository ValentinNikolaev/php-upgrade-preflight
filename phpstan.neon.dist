includes:
    - phpstan-production-baseline.neon

parameters:
    level: 6
    # Each configuration needs its own tmpDir: PHPStan keeps a single resultCache.php
    # per directory, so a shared tmpDir would make the two analyse passes evict each
    # other's cache on every run.
    tmpDir: build/phpstan/dev
    treatPhpDocTypesAsCertain: false
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    paths:
        - packages
        - tests/Release
        - tests/Support
        - tools
        # Individual demo scripts, never the examples/ tree: the demo target is
        # immutable fixture input whose bytes the committed reports fingerprint,
        # so its PHP files must not be analyzed or rewritten by tooling.
        - examples/five-minute-demo/regenerate-reports.php
        - examples/five-minute-demo/summarize-report.php
