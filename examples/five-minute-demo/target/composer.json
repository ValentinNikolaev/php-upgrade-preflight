{
  "name": "demo/laravel-10-application",
  "description": "Deterministic offline target for the PHP Upgrade Preflight five-minute demo.",
  "type": "project",
  "license": "PolyForm-Noncommercial-1.0.0",
  "repositories": [
    {
      "type": "path",
      "url": "../repository/*",
      "options": {
        "symlink": false,
        "reference": "none"
      }
    },
    {
      "packagist.org": false
    }
  ],
  "require": {
    "php": "^8.1",
    "laravel/framework": "^10.0",
    "laravel/tinker": "^2.9",
    "nesbot/carbon": "^2.72"
  },
  "require-dev": {
    "nunomaduro/collision": "^7.11",
    "phpunit/phpunit": "^10.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  }
}
