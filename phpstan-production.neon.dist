includes:
    - phpstan-production-baseline.neon

parameters:
    level: 7
    # See phpstan.neon.dist: the two configurations must not share a result cache.
    tmpDir: build/phpstan/production
    treatPhpDocTypesAsCertain: false
    bootstrapFiles:
        - tests/phpstan-bootstrap.php
    paths:
        - packages/core/src
        - packages/cli/src
        - packages/cli/bin/upgrade-intel
        - packages/laravel/src
        - tools
