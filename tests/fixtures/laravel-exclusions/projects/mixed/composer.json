{
  "name": "fixture/laravel-exclusions-mixed",
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/*",
      "options": {
        "symlink": false
      }
    },
    {
      "packagist.org": false
    }
  ],
  "require": {
    "php": "^8.0",
    "laravel/framework": "^12.0",
    "illuminate/support": "^11.0|^12.0|^13.0"
  },
  "config": {
    "platform": {
      "php": "8.3.0"
    }
  }
}
