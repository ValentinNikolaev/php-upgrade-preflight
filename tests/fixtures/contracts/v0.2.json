{
    "contract": "php-upgrade-preflight-v0.2",
    "tool_line": "0.2",
    "schema": "0.7",
    "transition_semantics": {
        "statuses": {
            "supported": "The source and target each resolve to exactly one major and one approved direct rule pack or every required adjacent hop has an implemented rule pack.",
            "partially_supported": "The source and target each resolve to exactly one major and an implemented contiguous prefix from the source covers at least one, but not every, required adjacent hop.",
            "unsupported": "No safe complete or partial guidance path can be constructed because no required hop is implemented, a major is ambiguous or unknown, the request is not an upgrade, or it lies outside the catalog."
        },
        "rules": {
            "ambiguous_source": {
                "status": "unsupported",
                "hops": [],
                "uncertainty_required": true,
                "best_guess_forbidden": true
            },
            "ambiguous_target": {
                "status": "unsupported",
                "hops": [],
                "uncertainty_required": true,
                "best_guess_forbidden": true
            },
            "missing_some_hops": {
                "status": "partially_supported",
                "covered_prefix_from_source_required": true,
                "missing_hops_must_be_listed": true,
                "uncertainty_required": true,
                "guidance_must_not_cross_gap": true,
                "post_gap_coverage_ignored": true
            },
            "first_hop_missing": {
                "status": "unsupported",
                "hops": [],
                "missing_hops_must_be_listed": true,
                "uncertainty_required": true,
                "post_gap_coverage_ignored": true
            },
            "missing_all_hops": {
                "status": "unsupported",
                "missing_hops_must_be_listed": true,
                "uncertainty_required": true
            },
            "non_upgrade": {
                "status": "unsupported",
                "uncertainty_required": true
            }
        }
    },
    "composition": {
        "independent_dimensions": [
            "resolution.status",
            "transition.framework_guidance[].status"
        ],
        "resolution_statuses": [
            "feasible",
            "feasible_with_changes",
            "blocked",
            "unknown"
        ],
        "transition_statuses": [
            "supported",
            "partially_supported",
            "unsupported"
        ],
        "rules": [
            "resolution.status describes only the direct final-target Composer scenarios and never claims framework rule coverage.",
            "framework transition status describes only guidance coverage and never claims that Composer can resolve the final target.",
            "transition.package_changes comes only from the selected successful direct final-target Composer scenario; it is never a prediction for an adjacent hop.",
            "framework hops are ordered guidance stages. A hop has no Composer feasibility result unless a distinct scenario for that hop was actually executed.",
            "framework findings identify their applicable hop or hops and cannot be generalized across a missing hop.",
            "A blocked or unknown direct resolution does not erase supported framework guidance; a feasible direct resolution does not upgrade partial or unsupported guidance.",
            "The staged plan resolves direct Composer blockers before applying package changes, then follows covered framework hops in ascending order without crossing a missing hop."
        ]
    },
    "schema_0_7": {
        "new_required_top_level_fields": [
            "platform",
            "source_inventory"
        ],
        "transition_additions": [
            "framework_guidance"
        ],
        "platform_fields": [
            "analyzer.php_version",
            "analyzer.provenance",
            "current_php.version",
            "current_php.provenance",
            "target_php.version",
            "target_php.provenance",
            "extensions.provenance",
            "extensions.explicitly_modeled",
            "extensions.completeness",
            "extensions.unmodeled_provenance",
            "extensions.assumptions"
        ],
        "source_impact_fields": [
            "affected_package",
            "ownership",
            "relevance",
            "reason",
            "severity",
            "occurrences",
            "evidence"
        ],
        "framework_finding_additions": [
            "applies_to_hops"
        ],
        "migration": {
            "dispatch_on": "metadata.schema_version",
            "v0_6_source_impact_becomes": "source_inventory",
            "v0_7_source_impact_meaning": "Only source usages correlated with a package change or an applicable framework rule.",
            "unknown_ownership_is_nullable": true,
            "historical_reports_are_not_rewritten": true
        },
        "historical_artifacts": {
