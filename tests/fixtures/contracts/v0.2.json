    "development_version": {
        "report_tool_version": "0.2.1",
        "composer_development_version": "0.2.x-dev",
        "internal_constraint": "^0.2",
        "active_release_series": "0.2",
        "release_candidate_approved": true
    },
    "budgets": {
        "corpus": [
            "blocked-illuminate-constraint",
            "ignition-legacy-skeleton",
            "laravel-7-to-8",
            "laravel-7-to-9",
            "laravel-package-matrix",
            "php-extension-conflict"
        ],
        "report_size": {
            "json_per_fixture_bytes": 131072,
            "markdown_per_fixture_bytes": 65536,
            "combined_corpus_bytes": 786432
        },
        "runtime": {
            "corpus_seconds": 30,
            "measurement": "One process, warm Composer install, fixture runner, debug disabled."
        },
        "memory": {
            "peak_bytes": 268435456,
            "measurement": "memory_get_peak_usage(true) for the one-process representative corpus run."
        },
        "redaction": {
            "allowed_seeded_canary_occurrences": 0,
            "surfaces": [
                "canonical_json",
                "markdown",
                "evidence",
                "exception_messages",
                "debug_output",
                "console_diagnostics",
                "ci_logs",
                "release_archives"
            ]
        },
        "path_exposure": {
            "default_shareable_markers": {
                "project": "[PROJECT_ROOT]",
                "output": "[REPORT_OUTPUT]",
                "local_repository": "[LOCAL_REPOSITORY]",
                "analyzer_workspace": "[ANALYZER_WORKSPACE]"
            },
            "source_locations_are_project_relative": true,
            "exact_workspace_requires_debug": true,
            "debug_artifacts_are_shareable": false,
            "credentials_are_redacted_in_debug": true
        },
        "determinism": {
            "reruns": 3,
            "require_byte_identical_normalized_reports": true,
            "platform_scope": {
                "modeled_extensions_are_host_independent": true,
                "partial_unlisted_extensions_are_host_dependent": true,
                "complete_input_required_for_full_host_independence": true
            },
            "ordering": {
                "targets": "package ascending",
                "scenarios": "selector order",
                "package_changes": "package name ascending",
                "framework_guidance": "framework then source major then target major ascending",
                "hops": "from major then target major ascending",
                "source_inventory": "canonical file path ascending, then parser traversal order with exact file/symbol/type/line duplicates merged",
                "source_impact": "source inventory order",
                "framework_findings": "framework integration registration order, then rule catalog order",
                "uncertainties": "first production order with exact duplicates removed",
                "evidence": "ledger insertion order"
            }
        }
    }
}
