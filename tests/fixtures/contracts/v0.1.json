{
    "contract": "php-upgrade-preflight-v0.1",
    "released_version": "0.1.0",
    "released_commit": "a8d154826f35fcb25a22868556534cc8c0331c0c",
    "public_php_operation": {
        "interface": "PhpUpgradePreflight\\Core\\Contracts\\UpgradeAnalyzer",
        "method": "analyzeUpgrade",
        "public": true,
        "static": false,
        "parameters": [
            {
                "name": "request",
                "type": "PhpUpgradePreflight\\Core\\Model\\UpgradeRequest",
                "optional": false,
                "by_reference": false,
                "variadic": false
            }
        ],
        "return_type": "PhpUpgradePreflight\\Core\\Model\\UpgradeReport"
    },
    "cli": {
        "binary": "upgrade-intel",
        "command": "analyze",
        "arguments": [
            {
                "syntax": "--path=PATH",
                "repeatable": false,
                "default": "current directory"
            },
            {
                "syntax": "--target=PACKAGE:VALUE",
                "repeatable": true,
                "default": []
            },
            {
                "syntax": "--target-php=VERSION",
                "repeatable": false,
                "default": null
            },
            {
                "syntax": "--from-php=VALUE",
                "repeatable": false,
                "default": null
            },
            {
                "syntax": "--source=PATH",
                "repeatable": true,
                "default": []
            },
            {
                "syntax": "--framework=NAME",
                "repeatable": true,
                "default": []
            },
            {
                "syntax": "--format=json|markdown",
                "repeatable": false,
                "default": "json"
            },
            {
                "syntax": "--output=PATH",
                "repeatable": false,
                "default": null
            },
            {
                "syntax": "--debug",
                "repeatable": false,
                "default": false
            },
            {
                "syntax": "-h, --help",
                "repeatable": false,
                "default": false
            }
        ],
        "help": "Usage:\n  upgrade-intel analyze --target=package:constraint [options]\n\nOptions:\n  --path=PATH             Project path to analyze (default: current directory)\n  --target=PACKAGE:VALUE  Target package constraint; repeatable\n  --target-php=VERSION    Explicit target PHP platform version\n  --from-php=VALUE        Current project PHP version\n  --source=PATH           Additional source path to scan; repeatable\n  --framework=NAME        Framework integration to enable; repeatable\n  --format=json|markdown  Report format (default: json)\n  --output=PATH           Write the report to a file\n  --debug                 Preserve temporary Composer workspaces\n  -h, --help              Show this help\n",
        "probe_argv": [
            "upgrade-intel",
            "analyze",
            "--path=<PROJECT_PATH>",
            "--target=laravel/framework:^9.0",
            "--target=vendor/package:^2.0",
            "--target-php=8.1",
            "--from-php=7.4",
            "--source=packages/core/src",
            "--source=packages/cli/src",
            "--framework=laravel",
            "--framework=fixture",
            "--format=markdown",
            "--output=<PROJECT_PATH>/../upgrade-report.md",
            "--debug"
        ],
        "probe_result": {
            "path": "<PROJECT_PATH>",
            "target": [
                "laravel/framework:^9.0",
                "vendor/package:^2.0"
            ],
            "target-php": "8.1",
            "from-php": "7.4",
            "source": [
                "packages/core/src",
                "packages/cli/src"
            ],
            "framework": [
                "laravel",
                "fixture"
            ],
            "format": "markdown",
            "output": "<PROJECT_PATH>/../upgrade-report.md",
            "debug": true
        },
        "default_probe_result": {
            "path": "<CURRENT_DIRECTORY>",
            "target": [],
            "target-php": "8.2",
            "from-php": null,
            "source": [],
            "framework": [],
            "format": "json",
            "output": null,
            "debug": false
        }
    },
    "exit_policy": {
        "success": {
            "code": 0,
            "conditions": [
                "help",
                "completed canonical report, including blocked or unknown resolution"
            ]
        },
        "failure": {
            "code": 1,
            "conditions": [
                "internal or operational failure prevented report production"
            ]
        },
        "invalid": {
            "code": 2,
            "conditions": [
                "invalid invocation"
            ]
        }
    },
