{
  "name": "php-upgrade-preflight/laravel",
  "description": "Laravel adapter and rules for PHP Upgrade Preflight.",
  "type": "library",
  "license": "PolyForm-Noncommercial-1.0.0",
  "keywords": [
    "composer",
    "dependency-analysis",
    "laravel",
    "php",
    "upgrade"
  ],
  "homepage": "https://github.com/ValentinNikolaev/php-upgrade-preflight",
  "authors": [
    {
      "name": "Valentin Nikolaev"
    }
  ],
  "support": {
    "issues": "https://github.com/ValentinNikolaev/php-upgrade-preflight/issues",
    "source": "https://github.com/ValentinNikolaev/php-upgrade-preflight/tree/main/packages/laravel"
  },
  "require": {
    "php": "^8.0",
    "composer/semver": "^3.4",
    "illuminate/console": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
    "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
    "php-upgrade-preflight/core": "^0.2"
  },
  "autoload": {
    "psr-4": {
      "PhpUpgradePreflight\\Laravel\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "PhpUpgradePreflight\\Laravel\\Tests\\": "tests/"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-main": "0.2.x-dev"
    },
    "php-upgrade-preflight": {
      "framework-adapters": [
        "PhpUpgradePreflight\\Laravel\\LaravelFrameworkIntegration"
      ]
    },
    "laravel": {
      "providers": [
        "PhpUpgradePreflight\\Laravel\\UpgradePreflightServiceProvider"
      ]
    }
  }
}
